<mxfile host="app.diagrams.net" modified="2026-11-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="paper-trail-architecture" name="System Architecture">
    <mxGraphModel dx="2100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Paper Trail + Graph RAG — Current System Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Solid arrows = implemented data/control flow · dashed arrows = optional or explicitly enabled paths · SQLite is the Paper Trail source of truth" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1750" height="28" as="geometry"/></mxCell>

        <mxCell id="lane_ingest" value="A · INVOICE INTAKE, EXTRACTION, EVIDENCE, AND REVIEW" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#F5F8FC;swimlaneFillColor=#F5F8FC;strokeColor=#AAB7C4;fontStyle=1;fontSize=16;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="2240" height="480" as="geometry"/></mxCell>
        <mxCell id="lane_query" value="B · PAPER TRAIL GRAPH VIEW AND QUESTION ANSWERING" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#F5FAF8;swimlaneFillColor=#F5FAF8;strokeColor=#AAB7C4;fontStyle=1;fontSize=16;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="2240" height="330" as="geometry"/></mxCell>
        <mxCell id="lane_store" value="C · PERSISTENCE, GRAPH PROJECTION, AND MODEL SERVICES" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#FBF8FC;swimlaneFillColor=#FBF8FC;strokeColor=#AAB7C4;fontStyle=1;fontSize=16;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="2240" height="235" as="geometry"/></mxCell>
        <mxCell id="lane_agent" value="D · STANDALONE kg_agent PACKAGE (SEPARATE DATA AND RUNTIME; NOT WIRED INTO PAPER TRAIL)" style="swimlane;html=1;startSize=34;horizontal=1;rounded=1;fillColor=#FFF9F0;swimlaneFillColor=#FFF9F0;strokeColor=#D6A400;fontStyle=1;fontSize=16;fontColor=#6B4F00;" vertex="1" parent="1"><mxGeometry x="30" y="1215" width="2240" height="205" as="geometry"/></mxCell>

        <mxCell id="source" value="DOCUMENT SOURCES&lt;br&gt;&lt;b&gt;watched/&lt;/b&gt; folder&lt;br&gt;JPG / PNG / PDF&lt;br&gt;User drops or copies files here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="205" height="120" as="geometry"/></mxCell>
        <mxCell id="watcher" value="WATCHER&lt;br&gt;Polls folder; waits for stable files; hashes content; detects add/change/delete; creates jobs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="315" y="190" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="registry" value="JOB / DOCUMENT REGISTRY&lt;br&gt;&lt;b&gt;SQLite&lt;/b&gt;&lt;br&gt;Versions, content hashes, queue state, attempts, deletion and retry state." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="315" y="355" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="worker" value="SINGLE BACKGROUND WORKER&lt;br&gt;Claims queued job; checks current hash; bounded document load; retries transient failures." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="590" y="190" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="load" value="DOCUMENT INPUT&lt;br&gt;PDF text extraction when available; bounded PDF page rendering; image decoding; limits on pages / pixels." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0097A7;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="875" y="190" width="225" height="120" as="geometry"/></mxCell>
        <mxCell id="parser" value="OPTIONAL TEXT PARSER / OCR&lt;br&gt;Tesseract or RapidOCR; returns text, boxes, and row hints for evidence mapping.&lt;br&gt;PaddleOCR preview is separate, not in this pipeline." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0097A7;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="875" y="355" width="225" height="125" as="geometry"/></mxCell>
        <mxCell id="extract" value="EXTRACTION PROVIDER&lt;br&gt;&lt;b&gt;Donut / OCR / opt-in vision API&lt;/b&gt;&lt;br&gt;Produces candidate invoice fields and line items; provider/model/prompt provenance recorded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1150" y="235" width="240" height="135" as="geometry"/></mxCell>
        <mxCell id="validate" value="VALIDATE + PRESERVE EVIDENCE&lt;br&gt;Canonical schema; field/source matches; arithmetic findings; provenance. Invalid outputs fail/retry. No model field is silently corrected." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1450" y="235" width="245" height="135" as="geometry"/></mxCell>
        <mxCell id="ledger" value="VERSIONED LEDGER + GRAPH STORE&lt;br&gt;&lt;b&gt;SQLite source of truth&lt;/b&gt;&lt;br&gt;Extractions, claims, evidence, review history, graph facts, change log. New facts start as needs_review." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1740" y="220" width="245" height="155" as="geometry"/></mxCell>
        <mxCell id="reviewer" value="HUMAN REVIEW&lt;br&gt;Inspect source + extracted fields + evidence; approve/correct or flag issues. Review edits update ledger and supported graph facts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="2020" y="235" width="210" height="135" as="geometry"/></mxCell>
        <mxCell id="ui" value="PAPER TRAIL FRONTENDS&lt;br&gt;&lt;b&gt;React/Vite UI&lt;/b&gt; via local API proxy; plus token-protected loopback review UI.&lt;br&gt;Documents · review · graph · ask/chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="685" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="api" value="REVIEW / APPLICATION SERVER&lt;br&gt;Local loopback API; validates review token; serves document, evidence, graph, review, settings, Neo4j, and Graph RAG routes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="685" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="retriever" value="PAPER TRAIL GRAPH RETRIEVER&lt;br&gt;Read-only, bounded query over SQLite graph; reviewed-only by default; returns facts, paths, and supporting source IDs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="740" y="685" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="answerapi" value="ANSWER SERVICE&lt;br&gt;Builds grounded context; optional local/remote model call; rate limit + cache; returns citations, evidence, confidence/status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1100" y="685" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="responseui" value="RESULTS IN UI&lt;br&gt;Answer and citations; inspect evidence and graph paths; trace/cache status where available." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1460" y="685" width="235" height="125" as="geometry"/></mxCell>
        <mxCell id="neo4jui" value="OPTIONAL GRAPH EXPLORATION&lt;br&gt;Neo4j Browser / Docker; frontend graph-neighborhood view; SQLite stays available if Neo4j is stopped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0097A7;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1810" y="685" width="250" height="125" as="geometry"/></mxCell>

        <mxCell id="graphdb" value="PAPER TRAIL GRAPH (SQLite)&lt;br&gt;Deterministic projection from active supported claims; entities and typed edges; graph rebuilt/checked from ledger." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="390" y="1025" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="neo4j" value="NEO4J (OPTIONAL DOCKER)&lt;br&gt;Rebuildable visualization/query projection; sync is one-way from SQLite; not source of truth." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="760" y="1025" width="280" height="125" as="geometry"/></mxCell>
        <mxCell id="ollama" value="OLLAMA LOCAL&lt;br&gt;Configured local models for Graph RAG; request stays on device. Current code uses configured GRAPH_RAG_MODEL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1120" y="1000" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="anthropic" value="ANTHROPIC HOSTED (OPT-IN)&lt;br&gt;Only retrieved graph facts are sent; requires explicit consent phrase, API key, and model configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontSize=13;spacing=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="1115" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="config" value="LOCAL CONFIG / SECRETS&lt;br&gt;.env is private; provider, model, paths, limits, and explicit remote-consent settings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#AAB7C4;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1510" y="1025" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="watchdb" value="INGESTION REGISTRY&lt;br&gt;Separate SQLite database for file/job state; not the graph ledger." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="1025" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="localindex" value="kg_agent LOCAL SOURCES&lt;br&gt;Standalone file/graph store and optional persistent dense index (Nomic embeddings); separate from Paper Trail SQLite." style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="60" y="1285" width="265" height="105" as="geometry"/></mxCell>
        <mxCell id="agentapi" value="kg_agent CLI / FastAPI&lt;br&gt;/ask · /schema · /trace/{id}&lt;br&gt;Query plan → keyword / dense / graph retrieval → fusion / rerank → context / citations." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="390" y="1285" width="295" height="105" as="geometry"/></mxCell>
        <mxCell id="agentllm" value="kg_agent MODEL SERVICES&lt;br&gt;Ollama chat model + optional OpenRouter; Nomic embeddings; query planning and answer generation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="760" y="1285" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="agentresult" value="Agent response&lt;br&gt;Evidence citations + graph paths + trace JSON under runs/." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#D6A400;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1120" y="1285" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="boundary" value="BOUNDARY&lt;br&gt;kg_agent is a separate experimental package. It does not currently share Paper Trail ingestion, review ledger, API, or graph store." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9F0;strokeColor=#D6A400;fontSize=13;fontStyle=1;spacing=9;" vertex="1" parent="1"><mxGeometry x="1510" y="1285" width="390" height="105" as="geometry"/></mxCell>

        <mxCell id="i1" value="scan / hash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="source" target="watcher"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i2" value="register jobs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="watcher" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i3" value="claim / update job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="registry" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i4" value="load current document" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="worker" target="load"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i5" value="optional parse text / layout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#0097A7;fontSize=11;" edge="1" parent="1" source="load" target="parser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i6" value="document + optional OCR text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0097A7;fontSize=11;" edge="1" parent="1" source="load" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i7" value="text + boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0097A7;fontSize=11;" edge="1" parent="1" source="parser" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i8" value="candidate JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6A400;fontSize=11;" edge="1" parent="1" source="extract" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i9" value="valid but needs review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="validate" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i10" value="review / correction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="1" source="ledger" target="reviewer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i11" value="write review decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="1" source="reviewer" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i12" value="file registry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;" edge="1" parent="1" source="registry" target="watchdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i13" value="graph and ledger data" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="ledger" target="graphdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q1" value="token-authenticated API calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q2" value="upload / review / graph / ask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="api" target="ledger"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q3" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="api" target="retriever"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q4" value="bounded facts / paths + support IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="retriever" target="answerapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q5" value="answer + citations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;fontSize=11;" edge="1" parent="1" source="answerapi" target="responseui"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q6" value="graph read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="retriever" target="graphdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q7" value="read facts / graph API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="api" target="graphdb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="q8" value="interactive exploration" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#0097A7;fontSize=11;" edge="1" parent="1" source="neo4jui" target="neo4j"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1" value="full snapshot / rebuildable projection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=11;" edge="1" parent="1" source="graphdb" target="neo4j"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2" value="Neo4j sync action" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6C8EBF;fontSize=11;" edge="1" parent="1" source="api" target="neo4j"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3" value="local model request / grounded context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="answerapi" target="ollama"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s4" value="explicit opt-in only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="1" source="answerapi" target="anthropic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s5" value="secrets / settings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#AAB7C4;fontSize=11;" edge="1" parent="1" source="config" target="ollama"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s6" value="endpoint / model / explicit consent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#AAB7C4;fontSize=11;" edge="1" parent="1" source="config" target="anthropic"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a1" value="own data / index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6A400;fontSize=11;" edge="1" parent="1" source="localindex" target="agentapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" value="optional planner / answer calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="agentapi" target="agentllm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" value="cited response + trace" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6A400;fontSize=11;" edge="1" parent="1" source="agentapi" target="agentresult"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
