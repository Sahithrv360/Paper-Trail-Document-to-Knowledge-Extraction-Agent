<mxfile host="app.diagrams.net" modified="2026-11-03T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="graph-rag-flow" name="Question to Answer">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Invoice Graph RAG: from question to cited answer" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1200" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Local flow: application code retrieves evidence; the LLM plans and writes from the selected context." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#526579;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1400" height="30" as="geometry"/></mxCell>

        <mxCell id="user" value="1 · USER / UI&lt;br&gt;&lt;b&gt;Question + mode + chat history&lt;/b&gt;&lt;br&gt;Example: “Which invoices link Acme to Northwind?”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="api" value="2 · API&lt;br&gt;&lt;b&gt;POST /ask&lt;/b&gt;&lt;br&gt;Validates request and invokes the agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="190" width="190" height="115" as="geometry"/></mxCell>
        <mxCell id="transform" value="3 · QUERY TRANSFORMER&lt;br&gt;&lt;b&gt;Understand the question&lt;/b&gt;&lt;br&gt;Expand glossary terms; resolve supported follow-ups; link invoice IDs and entity names; infer intent and retrieval tools." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="260" height="155" as="geometry"/></mxCell>
        <mxCell id="planllm" value="OPTIONAL QUERY PLANNER&lt;br&gt;LLM returns a constrained JSON QueryPlan&lt;br&gt;Allowed entity / relation types and node IDs are checked in code. Rule-based plan is the fallback." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=13;spacing=9;dashed=1;" vertex="1" parent="1"><mxGeometry x="540" y="370" width="260" height="120" as="geometry"/></mxCell>

        <mxCell id="keyword" value="4A · KEYWORD SEARCH&lt;br&gt;&lt;b&gt;BM25&lt;/b&gt;&lt;br&gt;Ranks exact words, invoice numbers, names, and terms." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0097A7;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="dense" value="4B · DENSE SEARCH&lt;br&gt;&lt;b&gt;Nomic embeddings&lt;/b&gt;&lt;br&gt;Encodes the question as a vector; finds semantically similar text chunks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0097A7;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="235" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="graph" value="4C · GRAPH SEARCH&lt;br&gt;&lt;b&gt;Nodes + edges&lt;/b&gt;&lt;br&gt;Starts from linked entities; follows bounded relationships. Global questions can use graph summaries." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#0097A7;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="870" y="380" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="fusion" value="5 · FUSE RESULTS&lt;br&gt;&lt;b&gt;RRF&lt;/b&gt;&lt;br&gt;Reciprocal Rank Fusion combines rankings from the selected tools and removes duplicate evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1160" y="230" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="rerank" value="6 · RERANK&lt;br&gt;Reorders the candidates by relevance to this question; keeps the strongest evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1440" y="230" width="200" height="115" as="geometry"/></mxCell>
        <mxCell id="context" value="7 · BUILD CONTEXT&lt;br&gt;&lt;b&gt;Evidence packet&lt;/b&gt;&lt;br&gt;Selects a limited set of chunks, triples, or paths; attaches citation IDs such as C1 or T1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1700" y="230" width="220" height="115" as="geometry"/></mxCell>
        <mxCell id="answer" value="8 · ANSWER MODEL&lt;br&gt;&lt;b&gt;Qwen2.5 1.5B Instruct&lt;/b&gt;&lt;br&gt;Receives the question + selected context and returns a concise, cited answer (JSON)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1980" y="220" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="verify" value="9 · VERIFY&lt;br&gt;Checks citations refer to supplied evidence and whether the response appears complete." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#D79B00;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1980" y="420" width="200" height="105" as="geometry"/></mxCell>
        <mxCell id="response" value="10 · RESPONSE&lt;br&gt;&lt;b&gt;Answer + citations + evidence + trace&lt;/b&gt;&lt;br&gt;Returned to the UI / caller." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#4A78A8;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1700" y="430" width="220" height="95" as="geometry"/></mxCell>
        <mxCell id="retry" value="If unsupported or incomplete in agent mode: broaden/reselect tools and retry (up to 2 refinements). Otherwise return the best supported result or “no supporting evidence found.”" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1160" y="430" width="480" height="95" as="geometry"/></mxCell>

        <mxCell id="prompttitle" value="PROMPT INPUTS (setup + per request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="555" width="250" height="40" as="geometry"/></mxCell>
        <mxCell id="schema" value="Graph schema&lt;br&gt;Known entity types, relation types, and structure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F0FA;strokeColor=#9673A6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="555" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="business" value="Business context&lt;br&gt;Domain, audience, glossary, answer style, goals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F0FA;strokeColor=#9673A6;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="590" y="555" width="250" height="75" as="geometry"/></mxCell>
        <mxCell id="systemprompt" value="SYSTEM PROMPT&lt;br&gt;Stable role + rules + domain guidance. Used when answering; it is not the invoice evidence and does not itself search the graph." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="870" y="555" width="330" height="75" as="geometry"/></mxCell>
        <mxCell id="questioncontext" value="PER-REQUEST INPUT&lt;br&gt;Current/standalone question + retrieved context + citation IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9673A6;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1230" y="555" width="320" height="75" as="geometry"/></mxCell>
        <mxCell id="boundary" value="Important boundary: the LLM receives selected evidence, not the complete invoice collection or entire graph. Retrieval is performed by the application before answer generation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6A400;fontSize=13;fontStyle=1;spacing=9;" vertex="1" parent="1"><mxGeometry x="1580" y="555" width="600" height="75" as="geometry"/></mxCell>

        <mxCell id="glossaryhead" value="TERMS IN THIS FLOW" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#17324D;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="350" height="30" as="geometry"/></mxCell>
        <mxCell id="glossary" value="&lt;b&gt;LLM&lt;/b&gt; — language model that plans (optionally) and writes the answer.&amp;nbsp;&amp;nbsp; &lt;b&gt;Embedding&lt;/b&gt; — numbers representing text meaning for similarity search.&amp;nbsp;&amp;nbsp; &lt;b&gt;Chunk&lt;/b&gt; — searchable passage from a document.&lt;br&gt;&lt;b&gt;Entity / node&lt;/b&gt; — a thing such as an invoice, vendor, or customer.&amp;nbsp;&amp;nbsp; &lt;b&gt;Relationship / edge&lt;/b&gt; — a typed link between nodes.&amp;nbsp;&amp;nbsp; &lt;b&gt;Retrieval&lt;/b&gt; — finding candidate evidence.&lt;br&gt;&lt;b&gt;Reranking&lt;/b&gt; — ordering candidates for this question.&amp;nbsp;&amp;nbsp; &lt;b&gt;Context&lt;/b&gt; — selected evidence given to the answer model.&amp;nbsp;&amp;nbsp; &lt;b&gt;Citation&lt;/b&gt; — ID connecting an answer claim to retrieved evidence.&amp;nbsp;&amp;nbsp; &lt;b&gt;Trace&lt;/b&gt; — record of tools, evidence counts, checks, and timing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#AAB7C4;fontSize=14;align=left;verticalAlign=middle;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="2140" height="120" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;" edge="1" parent="1" source="user" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;" edge="1" parent="1" source="api" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="optional JSON plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="transform" target="planllm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="question + plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;fontSize=11;" edge="1" parent="1" source="transform" target="keyword"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="transform" target="dense"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526579;" edge="1" parent="1" source="transform" target="graph"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="keyword" target="fusion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="dense" target="fusion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="graph" target="fusion"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="fusion" target="rerank"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82B366;" edge="1" parent="1" source="rerank" target="context"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673A6;" edge="1" parent="1" source="context" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="answer + citations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D79B00;fontSize=11;" edge="1" parent="1" source="answer" target="verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="verified result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4A78A8;fontSize=11;" edge="1" parent="1" source="verify" target="response"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="agent mode: broaden search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#D6A400;fontSize=11;" edge="1" parent="1" source="verify" target="retry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="retry retrieval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#D6A400;fontSize=11;" edge="1" parent="1" source="retry" target="transform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="system prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="systemprompt" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="question + evidence context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;fontSize=11;" edge="1" parent="1" source="questioncontext" target="answer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="schema" target="systemprompt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#9673A6;" edge="1" parent="1" source="business" target="systemprompt"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
