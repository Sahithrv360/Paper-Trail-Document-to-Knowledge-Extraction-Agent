# Copy to .env (git-ignored) and fill in only what you use. Never commit real values.

# Paths and polling
WATCH_FOLDER=./watched
DATABASE_PATH=./paper_trail.sqlite3
GRAPH_PATH=./paper_trail_graph.sqlite3
POLL_INTERVAL_SECONDS=2
MAX_FILE_MB=25

# Extraction: none (queue only, default) | donut | ocr | vision-api
EXTRACTION_PROVIDER=none
EXTRACTION_DEVICE=cpu
# Parser/OCR for evidence text: none | tesseract | rapidocr (ocr provider defaults to tesseract)
PARSER_ENGINE=
TESSERACT_CMD=tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=120

# Resource limits (one worker, one page at a time)
MAX_PAGES=5
MAX_PAGE_PIXELS=9000000
PDF_RENDER_DPI=300

# Remote vision API: disabled unless ALL of these are set.
# Setting the phrase means you accept that page images (and OCR text) leave this device.
PAPERTRAIL_ALLOW_REMOTE=
VISION_API_BACKEND=anthropic
VISION_API_MODEL=
VISION_API_KEY=
VISION_API_TIMEOUT_SECONDS=90
VISION_API_MAX_RETRIES=2
VISION_API_MAX_OUTPUT_TOKENS=4096
VISION_API_MAX_REQUEST_MB=8
VISION_API_MAX_IMAGE_PIXELS=2500000
VISION_API_SEND_PARSER_TEXT=1
# Optional, for a local cost estimate only (copy current prices from the vendor's page)
VISION_API_PRICE_INPUT_PER_MTOK=
VISION_API_PRICE_OUTPUT_PER_MTOK=

# Review server (binds to 127.0.0.1 only); leave empty to generate a token per start
REVIEW_PORT=8765
REVIEW_TOKEN=
